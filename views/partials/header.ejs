<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Система учета тренировок</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="/workouts<%= typeof isAuth !== 'undefined' && isAuth ? '?auth=1' : '' %>">Каталог тренировок</a>
        <div>
            <% if (typeof isAuth !== 'undefined' && isAuth) { %>
                <span class="text-white me-3">Пользователь авторизован</span>
                <a href="/workouts" class="btn btn-sm btn-outline-danger">Выйти</a>
            <% } else { %>
                <a href="/workouts?auth=1" class="btn btn-sm btn-success">Войти в систему</a>
            <% } %>
        </div>
    </div>
</nav>
<div class="container">