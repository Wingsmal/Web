.<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Список доступных тренировок</h2>
    <% if (isAuth) { %>
        <a href="/workouts/add?auth=1" class="btn btn-primary">Добавить новую</a>
    <% } %>
</div>

<div class="row">
    <% if (workouts.length === 0) { %>
        <div class="alert alert-info">Записи о тренировках отсутствуют.</div>
    <% } else { %>
        <% workouts.forEach(workout => { %>
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title"><%= workout.title %></h5>
                        <p class="card-text text-muted">Сложность: <%= workout.difficulty %> | <%= workout.duration %> мин</p>
                        <a href="/workouts/<%= workout.id %><%= isAuth ? '?auth=1' : '' %>" class="btn btn-sm btn-outline-primary">Подробнее</a>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>

<%- include('partials/footer') %>